# ============================================================
#  CheckerPRO — Variables de entorno
#  Copia este archivo como .env y ajusta los valores
# ============================================================

# ── Aplicación ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=CheckerPRO

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=cambia_este_secret_en_produccion_min32chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── Base de datos — MASTER (escritura) ────────────────────
DB_MASTER_HOST=127.0.0.1
DB_MASTER_PORT=3306
DB_MASTER_USER=root
DB_MASTER_PASSWORD=Cacahuate$12
DB_MASTER_DATABASE=checador_abarrotes_pruebas
DB_MASTER_CONNECTION_LIMIT=10

# ── Base de datos — REPLICA (lectura) ─────────────────────
# Si no tienes replica, pon los mismos valores que MASTER
DB_REPLICA_HOST=127.0.0.1
DB_REPLICA_PORT=3306
DB_REPLICA_USER=root
DB_REPLICA_PASSWORD=Cacahuate$12
DB_REPLICA_DATABASE=checador_abarrotes_pruebas
DB_REPLICA_CONNECTION_LIMIT=20

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:8080

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Seguridad ─────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
